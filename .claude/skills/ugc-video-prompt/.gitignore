# Generation test artifacts (large mp4s, copied assets)
runs/
*.mp4

# Eval workspace (regenerated by the eval harness)
ugc-video-prompt-workspace/

# Python cache
__pycache__/
*.pyc

# Local credentials must NEVER be committed — they live in env vars or
# ~/.config/<vendor>/, not in the skill. Guard against accidents:
**/.credentials
**/*.env
*.key

# OS / editor cruft
.DS_Store
Thumbs.db
.vscode/
.idea/
